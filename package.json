{
    "name": "rotaterings-guide",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npm run seo:prepare && next build",
        "seo:prepare": "node scripts/generate-seo-manifest.mjs",
        "seo:validate": "node scripts/validate-seo-manifest.mjs public/seo-manifest.json",
        "sync:levels": "node scripts/sync-level-batch.mjs",
        "assets:level": "node scripts/generate-level-assets.mjs",
        "assets:index": "node scripts/build-level-match-index.mjs",
        "assets:validate": "node scripts/validate-level-assets.mjs",
        "test": "node --test tests/*.test.mjs",
        "typecheck": "tsc --noEmit",
        "start": "next start",
        "lint": "next lint"
    },
    "dependencies": {
        "@radix-ui/react-accordion": "^1.2.12",
        "@radix-ui/react-dialog": "^1.1.15",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-slot": "^1.2.4",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "cmdk": "^1.0.0",
        "lucide-react": "^0.460.0",
        "next": "^15.1.0",
        "next-themes": "^0.4.6",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sharp": "^0.34.5",
        "tailwind-merge": "^2.6.0",
        "tailwindcss-animate": "^1.0.7"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "autoprefixer": "^10.4.0",
        "eslint": "^9.0.0",
        "eslint-config-next": "^15.1.0",
        "postcss": "^8.4.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.6.0"
    }
}
